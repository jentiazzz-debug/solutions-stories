# Скопируй в .env рядом с main.py и заполни.

# Токен от @BotFather.
BOT_TOKEN=

# Кому открыта /admin. Через запятую. Свой id — у @userinfobot.
ADMIN_IDS=

# Нарезка стоит одинаково, на сколько бы частей ни резали.
CUT_PRICE=10

# Цена рамки для аватарки.
FRAME_PRICE=15

# Разные цены за разные сетки — если всё-таки понадобится лесенка.
# Пока переменная не задана, всё стоит CUT_PRICE.
# PRICES=3:10,6:20,9:25,12:30,15:35

# Сколько активных рефералов дают одну бесплатную генерацию.
REF_PER_FREE=3

# Бесплатных генераций новичку. 0 — как у конкурента, 1 — заметно выше
# конверсия в первую оплату.
WELCOME_CREDITS=1

# Чем заполнять поля сторис вокруг видимого окна: blur или black.
FILL_MODE=blur

# Ссылки в оформлении. Пусто — кнопка не появится.
EXAMPLE_URL=
SECOND_BOT_URL=https://t.me/emojimakerobot
SUPPORT_URL=https://t.me/nudick

# Только для хостингов с отдельным томом под данные.
# DATA_DIR=/data
